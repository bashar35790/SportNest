# =============================================================================
# SportNest Frontend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# Better Auth secret key — MUST match backend/.env
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public base URL of the Next.js app
# No spaces around the equals sign
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# MongoDB connection string (used in server components)
# Only needed if reading DB directly from the server
# In production, use a restricted user with read-only access
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sportnest?retryWrites=true&w=majority

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
